# Copy to .env or export directly.
DEEPSEAPORT_CONFIG=./config.json
DEEPSEAPORT_KEYS=sk-local-dev
DEEPSEAPORT_PORT=5001
# true -> bind 0.0.0.0 (LAN), false/default -> 127.0.0.1
DEEPSEAPORT_LISTEN=
# DeepSeek account (alternative to config.json)
DEEPSEEK_EMAIL=
DEEPSEEK_PASSWORD=
DEEPSEEK_TOKEN=
# Obscura overrides
OBSCURA_BIN=
OBSCURA_PROFILE=
# Behaviour overrides (mirror config.json; 1/true/yes/on = true)
# DEEPSEAPORT_ENABLE_TOOLS=1
# DEEPSEAPORT_WARMUP_ON_STARTUP=1
# DEEPSEAPORT_AUTO_DELETE_SESSION=1
# DEEPSEAPORT_MAX_RETRIES=1
# DEEPSEAPORT_PARALLEL_FETCH=1
# Tool-call argument cap in characters (default 200000; larger values let
# coders write bigger files in one call, at the cost of more memory).
# DEEPSEAPORT_MAX_ARGS_CHARS=200000
# DEEPSEAPORT_USE_MULTIPLE_ACCOUNTS=1
# DEEPSEAPORT_LOG_LEVEL=INFO
# DEEPSEAPORT_STREAM_MODE=live
# DEEPSEAPORT_CHAT_MODEL=deepseek-flash
